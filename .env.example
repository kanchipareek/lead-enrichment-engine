# Copy to .env and fill in. .env is gitignored - never commit real values.
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
GITHUB_TOKEN=your-github-token-here

# optional overrides (defaults shown, all read from env)
# LEADS_DB=data/lead_enrichment.db
# CRAWL_DELAY=1.2
# CRAWL_DOMAIN_DELAY=3.0
# CRAWL_TIMEOUT=10
# CRAWL_RETRIES=2
# CRAWL_MAX_PAGES=4
# GITHUB_DELAY=4.0
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# CRAWL_USER_AGENT=lead-enrichment-engine/1.0 (+contact: you@example.com)
